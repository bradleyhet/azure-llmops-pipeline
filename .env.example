# OpenRouter key used by the assistant at runtime and by the eval jobs.
# Locally: put it here. In Azure: it lives in Key Vault and reaches the app
# as a Container Apps secret reference. In GitHub: an environment secret used
# only by the eval jobs on the runner.
OPENROUTER_API_KEY=

# System under test (OpenRouter id). Recorded in every results row.
SUT_MODEL=google/gemini-2.5-flash

# Keep promptfoo from phoning home.
PROMPTFOO_DISABLE_TELEMETRY=1
