{
  "name": "corella-assistant",
  "version": "0.1.0",
  "description": "Corella Bank RAG support assistant as an HTTP service, shipped to Azure Container Apps by a reusable GitHub Actions pipeline",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Brad Hetherington",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "bun audit --audit-level=high --ignore=GHSA-jmr9-qjv8-65gv --ignore=GHSA-7pqw-9j4j-h8q3",
    "eval:smoke": "promptfoo eval -c promptfooconfig.yaml --filter-metadata tier=smoke --max-concurrency 4 -o results/smoke.json",
    "eval:smoke:http": "promptfoo eval -c promptfooconfig.http.yaml --filter-metadata tier=smoke --max-concurrency 4 --no-cache -o results/smoke-http.json",
    "eval:full:http": "promptfoo eval -c promptfooconfig.http.yaml --max-concurrency 3 --no-cache -o results/full-http.json",
    "eval:validate": "promptfoo validate -c promptfooconfig.yaml && promptfoo validate -c promptfooconfig.http.yaml"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "promptfoo": "0.123.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
